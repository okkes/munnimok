# Template — copy to .env.local and fill in. Real values never enter git.

# --- domains / registry -------------------------------------------------
DOMAIN=okkes.synology.me
REGISTRY=cr.okkes.synology.me
TAG=latest

# --- postgres (shared instance: munni + logto + glitchtip databases) -----
POSTGRES_PASSWORD=

# --- logto ----------------------------------------------------------------
# API resource indicator configured in the Logto admin console
LOGTO_API_RESOURCE=https://munni-api.okkes.synology.me

# --- glitchtip -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
GLITCHTIP_SECRET_KEY=
# optional smtp url, e.g. smtp://user:pass@mail:587 (defaults to console)
GLITCHTIP_EMAIL_URL=
API_SENTRY_DSN=

# --- gocardless bank account data (bankaccountdata.gocardless.com) --------
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- backups ---------------------------------------------------------------
# NAS path picked up by Hyper Backup
BACKUP_DIR=/volume1/backups/munni
