# Template — copy to .env.local and fill in. Real values never enter git.

# --- domains / registry -------------------------------------------------
DOMAIN=okkes.synology.me
# images are published to GHCR by GitHub Actions
REGISTRY=ghcr.io/okkes
TAG=latest
# GitHub username + fine-grained PAT with read:packages only.
# update.sh re-logs-in from these on every run (reboot/upgrade-proof).
GHCR_USER=okkes
GHCR_PAT=

# --- postgres (shared instance: munni + logto + glitchtip databases) -----
POSTGRES_PASSWORD=

# --- logto ----------------------------------------------------------------
# API resource indicator configured in the Logto admin console
LOGTO_API_RESOURCE=https://munni-api.okkes.synology.me

# --- glitchtip -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
GLITCHTIP_SECRET_KEY=
# optional smtp url, e.g. smtp://user:pass@mail:587 (defaults to console)
GLITCHTIP_EMAIL_URL=
API_SENTRY_DSN=

# --- gocardless bank account data (bankaccountdata.gocardless.com) --------
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- admin ------------------------------------------------------------------
# comma-separated OIDC subs allowed into the in-app admin area.
# find yours: Logto console -> Users -> your user -> ID, or /me in the app.
ADMIN_SUBS=

# --- backups ---------------------------------------------------------------
# NAS path picked up by Hyper Backup
BACKUP_DIR=/volume1/backups/munni

# --- web push (generate once: npx web-push generate-vapid-keys) -----------
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@okkes.synology.me
