// munni-local — the full ecosystem on ONE developer machine (Docker
// Desktop): released images from ghcr, real minted secrets, plain http on
// localhost ports. No DSM, no DDNS, no GitHub Environment — bootstrap's
// local target persists secrets in infra/rendered/munni-local/ (gitignored)
// and renders a ready-to-run compose + .env pair. Distinct from
// deploy/docker-compose.local.yml (the from-source DEV stack): this twin
// answers "run the whole product locally", not "develop against it".
{
  "stack": "munni-local",
  "pair": "munni-local",
  "role": "prod", // owns its own logto + glitchtip like any prod twin
  // dev channel: `latest` only moves on RELEASES (master) — the twin
  // should run the same code as the checkout it renders from
  "channel": "dev",
  "target": "local",

  "domain": "localhost",
  "hosts": {
    "web": "localhost",
    "api": "localhost",
    "admin": "localhost",
    "logto": "localhost",
    "logtoAdmin": "localhost",
    "glitchtip": "localhost"
  },

  // 83xx block: clear of the live stacks (80xx/81xx), the iac pair (82xx)
  // and the from-source dev stack (8180/3001/3002)
  "ports": {
    "web": 8380,
    "admin": 8381,
    "api": 8382,
    "logto": 3201,
    "logtoAdmin": 3202,
    "glitchtip": 8383
  },

  "sharedServices": true,
  "registry": "ghcr.io/okkes",

  // native shells never target the local twin, but the logto module
  // provisions a native app per stack — harmless and consistent
  "native": {
    "appId": "app.munni.local",
    "label": "munni local",
    "scheme": "munni-local"
  },

  "features": {
    "telemetry": true,
    "importWatch": false,
    "pgadmin": false,
    "dbBackup": false
  }
}
