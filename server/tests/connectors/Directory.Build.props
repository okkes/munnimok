<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)../../src/connectors/Directory.Build.props" />
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- per-report gate off: a connector assembly is covered by several suites, so server/tests/coverage-gate.mjs
       (run by release-images.yml and the Sonar script) unions the reports against the same 85 % floor; collection stays on -->
  <PropertyGroup>
    <_MunniCollectsCoverage>false</_MunniCollectsCoverage>
  </PropertyGroup>
</Project>
