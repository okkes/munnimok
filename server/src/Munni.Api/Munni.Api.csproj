<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- GHSA-v5pm-xwqc-g5wc flags every 2.x but 3.x breaks AspNetCore.OpenApi's source generator; the flaw is in PARSING
         untrusted documents and this api only generates its own. Newest 2.x, suppressed until a 3.x-compatible generator ships -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" NoWarn="NU1903" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.13.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Accounts\keyword-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Munni.Api.Tests" />
  </ItemGroup>

</Project>
