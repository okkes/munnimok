<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RegistryConnector.Adapters</RootNamespace>
    <AssemblyName>RegistryConnector.Adapters</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Kit\Connector.Kit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RegistryConnector.Adapters.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Connector.Kit.Browsing" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixtures are embedded (no file paths in tests) and copied (an operator can diff a live capture against them) -->
    <None Remove="Fixtures\**\*.html" />
    <EmbeddedResource Include="Fixtures\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fixtures\**\*.json" />
    <EmbeddedResource Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
