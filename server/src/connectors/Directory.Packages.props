<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <!-- crash reports to GlitchTip (2026-10-05): the control plane as an ASP.NET host, the agent as a generic host -->
    <PackageVersion Include="Sentry.AspNetCore" Version="6.13.0" />
    <PackageVersion Include="Sentry.Extensions.Logging" Version="6.13.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Api documentation">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.20.0" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi 2.0.0,
      which carries a known high-severity advisory (GHSA-v5pm-xwqc-g5wc).
      Pinned forward rather than suppressed with NoWarn - the same call as
      SQLitePCLRaw in Connector.Kit.Hosting.csproj, and for the same reason:
      the advisory does not stop being real because it arrived transitively.
      CentralPackageTransitivePinningEnabled above is what makes this reach it.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup Label="Automation">
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

</Project>
