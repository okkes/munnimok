<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BankConnector.Adapters</RootNamespace>
    <AssemblyName>BankConnector.Adapters</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Kit\Connector.Kit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- readers and the portal seam are internal (not a contract); offline tests must reach them without a live bank session -->
    <InternalsVisibleTo Include="BankConnector.Adapters.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded, not copied: a working-directory dependency passes locally and fails in CI -->
    <EmbeddedResource Include="Parsing/Fixtures/*.xml" />
    <EmbeddedResource Include="Parsing/Fixtures/*.csv" />
    <!-- ING is read as JSON, not as a download: its fixtures are the API's payloads -->
    <EmbeddedResource Include="Ing/Fixtures/*.json" />
  </ItemGroup>

</Project>
