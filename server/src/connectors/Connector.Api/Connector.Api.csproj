<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- a shell on purpose: all control-plane behaviour lives in Connector.Kit.Hosting; no Playwright here -->
  <PropertyGroup>
    <RootNamespace>Connector.Api</RootNamespace>
    <AssemblyName>Connector.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- never in an image: one misspelled env var and the service falls back to Sqlite and an ephemeral key ring, sealing credentials under a key that dies with the process -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry.AspNetCore" />
    <ProjectReference Include="..\Connector.Kit.Hosting\Connector.Kit.Hosting.csproj" />
    <ProjectReference Include="..\BankConnector.Adapters\BankConnector.Adapters.csproj" />
    <ProjectReference Include="..\ShopConnector.Adapters\ShopConnector.Adapters.csproj" />
    <ProjectReference Include="..\RegistryConnector.Adapters\RegistryConnector.Adapters.csproj" />
  </ItemGroup>

</Project>
