{
  "ConnectorAgent": {
    // All three local control planes at once, which is the whole point of
    // this image and is now also the local way to exercise it: the bank API
    // on 8410, the shopping one on 8420 and the registry one on 8440, each
    // matching that project's launch profile. `dotnet run` in the three API
    // directories and this one is a complete local system with ONE agent.
    "Connections": [
      {
        "Name": "bank",
        "ControlPlaneBaseUrl": "http://localhost:8410/",

        // The one step that cannot be pre-configured: an enrollment code is
        // single-use and minted by the running control plane, and each
        // connector mints its own - a code is signed with that connector's
        // key and names the subject it was minted for. Mint one with
        //   POST /v1/agents/enrollment { "subject": "u_local", "name": "local-home-agent" }
        // against each control plane and paste them here, or pass
        // ConnectorAgent__Connections__0__EnrollmentCode. After a successful
        // enrollment the state file below carries that connector's identity
        // and its code is ignored.
        "EnrollmentCode": ""
      },
      {
        "Name": "shop",
        "ControlPlaneBaseUrl": "http://localhost:8420/",
        "EnrollmentCode": ""
      },
      {
        "Name": "registry",
        "ControlPlaneBaseUrl": "http://localhost:8440/",
        "EnrollmentCode": ""
      }
    ],

    "AgentName": "local-home-agent",

    // Never "residential" locally. Claiming it would let a job that genuinely
    // needs a residential line be routed to a laptop on hotel wifi.
    "Egress": { "Country": "NL", "Kind": "any" },

    // Unique per agent PROCESS. One process may serve every connector here -
    // the state file holds an entry each and the profile root gets a
    // directory each - but a second agent run beside it must not share these,
    // or the two would sweep each other's scratch directories out from under
    // running jobs. Under artifacts/ because the repo already ignores that
    // name at any depth: the state file holds live agent tokens and must
    // never be committed.
    "StateFilePath": "artifacts/agent-state.json",
    "ProfileRootDirectory": "artifacts/profiles",
    "WorkRootDirectory": "artifacts/work",

    // Headed locally is the useful default for adapter work: a login that
    // fails at an invisible selector is far cheaper to diagnose when the
    // browser is on screen. Flip it back for an unattended local run.
    "Headless": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Connector.Kit.Agent": "Debug"
    }
  }
}
