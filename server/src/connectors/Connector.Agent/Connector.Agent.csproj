<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One agent image carrying every adapter library, for a household (not one container per connector).
    Lives outside the connector folders: it references all three adapter libraries, so inside one it
    would invert the dependency direction of every other project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Connector.Agent</RootNamespace>
    <AssemblyName>Connector.Agent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Sentry.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- the plain SDK (unlike Web) does not publish appsettings.json; without it the agent has no control plane to call -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- never in an image: one misspelled env var and the agent quietly long-polls localhost while looking healthy -->
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" DependentUpon="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Kit.Agent\Connector.Kit.Agent.csproj" />
    <ProjectReference Include="..\BankConnector.Adapters\BankConnector.Adapters.csproj" />
    <ProjectReference Include="..\ShopConnector.Adapters\ShopConnector.Adapters.csproj" />
    <ProjectReference Include="..\RegistryConnector.Adapters\RegistryConnector.Adapters.csproj" />
  </ItemGroup>

</Project>
