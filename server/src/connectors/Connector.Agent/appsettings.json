{
  "ConnectorAgent": {
    // BYO BY DEFAULT, which is the one setting this image differs from the
    // three per-connector ones in - and it is not a preference. This image
    // exists to be the container somebody runs on their own machine, and a
    // pooled agent there would wipe its browser profiles between jobs, sign
    // itself out to tidy up after a failure, and advertise the tiers its
    // configuration listed rather than the ones its adapters need. Every one
    // of those is a silent wrong answer on a household NAS: the sign-in the
    // user did once is gone, and nothing says why.
    //
    // The per-connector images default to pooled because most of their
    // instances are the operator's fleet. Most instances of this one are
    // somebody's house.
    "Class": "byo",

    // ONE JOB AT A TIME, FOR THE WHOLE MACHINE. Not per connector: this
    // process serves several, and a job is a browser. Two at once on a
    // household machine are two Chromiums in one process, where a fault in
    // the process is a fault across both.
    "MaxConcurrency": 1,

    // Headless here, headed in deploy/byo/docker-compose.yml, which is the
    // supported way to run this image: the entrypoint starts an Xvfb for it,
    // and a browser with a screen is both harder for bot protection to
    // single out and the only kind a live view has anything to photograph.
    // Left true here so that `dotnet run` on a machine with no display works
    // at all.
    "Headless": true

    // No "Runtimes" here, on purpose. The tiers an agent advertises are
    // derived from the adapters it carries, and a list in a file like this
    // one is what quietly configured every BYO agent out of browser_persistent
    // - the one tier it exists for - while it enrolled, heartbeated and
    // looked healthy. A BYO agent now refuses to start on a list that omits a
    // tier its adapters need, so the only thing a list here can do is turn a
    // working agent into one that will not boot.
    //
    // The connectors, their enrollment codes and the three directories are
    // per-deployment and come from the environment:
    //   ConnectorAgent__Connections__0__Name=bank
    //   ConnectorAgent__Connections__0__ControlPlaneBaseUrl=https://...
    //   ConnectorAgent__Connections__0__EnrollmentCode=AGNT-....
    // and 1, 2, ... for the others. One agent, one container, one connector
    // per entry. The single-connector spelling - ConnectorAgent__ControlPlaneBaseUrl
    // and ConnectorAgent__EnrollmentCode - still works and means exactly one
    // connection; the two shapes together are refused rather than silently
    // preferred.
    //
    // Egress is per-deployment too and must be honest: this image belongs on
    // a residential line, and an instance in a datacenter claiming
    // "residential" earns exactly the jobs it will fail.
  },
  // Provider facts the adapters mark unconfirmed - DUO's portal paths, BKR's
  // selectors, Albert Heijn's client id, every Jumbo money unit - are
  // overridden here or from the environment rather than in a release. This
  // image carries all three sets because it carries all three products'
  // adapters; keep each in step with its control plane's copy, because the
  // two must not disagree about a money unit.
  "BankAdapters": {},
  "ShopAdapters": {},
  "RegistryAdapters": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
