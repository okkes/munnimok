<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Connector.Kit.Hosting</RootNamespace>
    <AssemblyName>Connector.Kit.Hosting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- scaffolding only (`dotnet ef migrations add`); PrivateAssets keeps it out of the image -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- API reference, mapped only outside production (MapConnectorReference) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLitePCLRaw 2.1.11 (via EF Sqlite) has GHSA-2m69-gcr7-jv3q and fails TreatWarningsAsErrors; overridden, not suppressed: it parses untrusted file content -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" VersionOverride="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Kit\Connector.Kit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- no test project of its own: tested through Connector.Api.Tests, which also reaches its pure decisions directly -->
    <InternalsVisibleTo Include="Connector.Api.Tests" />
  </ItemGroup>

</Project>
