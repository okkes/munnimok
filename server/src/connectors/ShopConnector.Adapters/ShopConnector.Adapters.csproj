<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ShopConnector.Adapters</RootNamespace>
    <AssemblyName>ShopConnector.Adapters</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Kit\Connector.Kit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the browser-login seam (ILoginPage, IRedirectWaiter) lives in the kit, shared with the registry connector; imported project-wide -->
    <Using Include="Connector.Kit.Browsing" />
  </ItemGroup>

  <ItemGroup>
    <!-- parsers are internal (not a contract); parse tests must reach them without an HTTP stub -->
    <InternalsVisibleTo Include="ShopConnector.Adapters.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixtures are embedded (no file paths in tests) and copied (an operator can diff a live capture against them) -->
    <None Remove="Fixtures\**\*.json" />
    <EmbeddedResource Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- bol: scoped to Fixtures\bol\ (a wildcard would collide with the next HTML provider); raw HTML so a live capture can be diffed.
         SYNTHETIC: no real bol order list has been seen; replace with a real capture on the first live run -->
    <None Remove="Fixtures\bol\*.html" />
    <EmbeddedResource Include="Fixtures\bol\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- a valid PDF standing in for a bol invoice; not sized off the live capture's 33667 bytes, which is a UTF-8-mangled ~18.9KB file -->
    <None Remove="Fixtures\**\*.pdf" />
    <EmbeddedResource Include="Fixtures\**\*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- amazon.nl invoice lists: bare HTML (the AJAX fragment behind "Factuur", no navigation status), not the { url, status, html }
         wrapper. REAL captures of 2026-08-06, redacted; the four-invoice one is genuine (hence a list) -->
    <None Remove="Fixtures\amazon\*.html" />
    <EmbeddedResource Include="Fixtures\amazon\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- coolblue: REAL captures, redacted (CoolblueLoginFormTests asserts it; one shipped with live signed tokens).
         Two sign-in screens on purpose: screen 1's only password input is a DECOY for password managers,
         screen 2's first submit button RESETS THE PASSWORD -->
    <None Remove="Fixtures\coolblue\*.html" />
    <EmbeddedResource Include="Fixtures\coolblue\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
