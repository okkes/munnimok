<?xml version="1.0" encoding="utf-8"?>
<!-- the platform's CA ships inside the app: CI bakes the machine's root into res/raw/family_ca.pem (the committed
     file is a placeholder), so the app trusts the sslip.io hosts with no manual install; user CAs stay trusted
     as the fallback. Cleartext off. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/family_ca" />
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
