<?xml version="1.0" encoding="utf-8"?>
<!-- hosted flavors: public CAs only. The local flavor overrides this file to also trust user-installed CAs,
     because the local family signs its sslip.io hosts with a Caddy CA minted on the operator's machine. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
